 	void *saved_req_buf;
+#ifdef CONFIG_USB_DWC2_R1_MEASURE
+	u64 r1_req_id;
+	u64 r1_map_id;
+	dma_addr_t r1_dma;
+	u32 r1_length;
+	bool r1_linear;
+#endif
 };
 
