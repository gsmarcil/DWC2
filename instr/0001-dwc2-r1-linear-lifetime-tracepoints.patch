diff --git a/drivers/usb/dwc2/gadget.c b/drivers/usb/dwc2/gadget.c
--- a/drivers/usb/dwc2/gadget.c
+++ b/drivers/usb/dwc2/gadget.c
@@ -20,6 +20,12 @@
 #include <linux/io.h>
 #include <linux/slab.h>
 
+#ifdef CONFIG_USB_DWC2_R1_MEASURE
+#include <linux/atomic.h>
+#define CREATE_TRACE_POINTS
+#include "trace-r1.h"
+#endif
+
 #include <linux/usb/ch9.h>
 #include <linux/usb/gadget.h>
 #include <linux/usb/phy.h>
@@ -107,6 +113,80 @@ static inline bool using_desc_dma(struct dwc2_hsotg *hsotg)
 	return hsotg->params.g_dma_desc;
 }
 
+enum dwc2_r1_lifetime_stage {
+	DWC2_R1_MAP = 1,
+	DWC2_R1_PROGRAMMED = 2,
+	DWC2_R1_UNMAP_BEGIN = 3,
+	DWC2_R1_UNMAP_DONE = 4,
+};
+
+#ifdef CONFIG_USB_DWC2_R1_MEASURE
+static atomic64_t dwc2_r1_req_seq = ATOMIC64_INIT(0);
+static atomic64_t dwc2_r1_map_seq = ATOMIC64_INIT(0);
+
+static void dwc2_r1_measure_reset(struct dwc2_hsotg_req *hs_req)
+{
+	hs_req->r1_req_id = 0;
+	hs_req->r1_map_id = 0;
+	hs_req->r1_dma = 0;
+	hs_req->r1_length = 0;
+	hs_req->r1_linear = false;
+}
+
+static bool dwc2_r1_measure_eligible(struct dwc2_hsotg *hsotg,
+				     struct dwc2_hsotg_ep *hs_ep,
+				     struct dwc2_hsotg_req *hs_req)
+{
+	struct usb_request *req = &hs_req->req;
+
+	return using_dma(hsotg) && !using_desc_dma(hsotg) && hs_ep->index &&
+	       !hs_ep->dir_in && hs_ep->ep.desc &&
+	       usb_endpoint_xfer_bulk(hs_ep->ep.desc) && req->length &&
+	       !req->sg_was_mapped && !req->num_sgs && req->dma_mapped &&
+	       !hs_req->saved_req_buf;
+}
+
+static void dwc2_r1_measure_mapped(struct dwc2_hsotg *hsotg,
+				   struct dwc2_hsotg_ep *hs_ep,
+				   struct dwc2_hsotg_req *hs_req)
+{
+	if (!dwc2_r1_measure_eligible(hsotg, hs_ep, hs_req))
+		return;
+
+	hs_req->r1_req_id = atomic64_inc_return(&dwc2_r1_req_seq);
+	hs_req->r1_map_id = atomic64_inc_return(&dwc2_r1_map_seq);
+	hs_req->r1_dma = hs_req->req.dma;
+	hs_req->r1_length = hs_req->req.length;
+	hs_req->r1_linear = true;
+	trace_dwc2_r1_lifetime(DWC2_R1_MAP, hs_req->r1_req_id,
+			       hs_req->r1_map_id, hs_ep->index,
+			       hs_req->r1_dma, hs_req->r1_length,
+			       hs_req->req.actual, 0, hs_req->req.status,
+			       hs_req->req.dma_mapped);
+}
+
+static void dwc2_r1_measure_event(struct dwc2_hsotg_ep *hs_ep,
+				  struct dwc2_hsotg_req *hs_req,
+				  u8 stage, int result)
+{
+	if (!hs_req->r1_linear)
+		return;
+
+	trace_dwc2_r1_lifetime(stage, hs_req->r1_req_id, hs_req->r1_map_id,
+			       hs_ep->index, hs_req->r1_dma, hs_req->r1_length,
+			       hs_req->req.actual, result, hs_req->req.status,
+			       hs_req->req.dma_mapped);
+}
+#else
+static inline void dwc2_r1_measure_reset(struct dwc2_hsotg_req *hs_req) { }
+static inline void dwc2_r1_measure_mapped(struct dwc2_hsotg *hsotg,
+					  struct dwc2_hsotg_ep *hs_ep,
+					  struct dwc2_hsotg_req *hs_req) { }
+static inline void dwc2_r1_measure_event(struct dwc2_hsotg_ep *hs_ep,
+					 struct dwc2_hsotg_req *hs_req,
+					 u8 stage, int result) { }
+#endif
+
 /**
  * dwc2_gadget_incr_frame_num - Increments the targeted frame number.
  * @hs_ep: The endpoint
@@ -1169,6 +1249,9 @@ static void dwc2_hsotg_start_req(struct dwc2_hsotg *hsotg,
 
 			dwc2_writel(hsotg, ureq->dma, dma_reg);
 
+			dwc2_r1_measure_event(hs_ep, hs_req,
+					       DWC2_R1_PROGRAMMED, 0);
+
 			dev_dbg(hsotg->dev, "%s: %pad => 0x%08x\n",
 				__func__, &ureq->dma, dma_reg);
 		}
@@ -1406,6 +1489,7 @@ static int dwc2_hsotg_ep_queue(struct usb_ep *ep, struct usb_request *req,
 	INIT_LIST_HEAD(&hs_req->queue);
 	req->actual = 0;
 	req->status = -EINPROGRESS;
+	dwc2_r1_measure_reset(hs_req);
 
 	/* Don't queue ISOC request if length greater than mps*mc */
 	if (hs_ep->isochronous &&
@@ -1441,6 +1525,7 @@ static int dwc2_hsotg_ep_queue(struct usb_ep *ep, struct usb_request *req,
 		ret = dwc2_hsotg_map_dma(hs, hs_ep, req);
 		if (ret)
 			return ret;
+		dwc2_r1_measure_mapped(hs, hs_ep, hs_req);
 	}
 	/* If using descriptor DMA configure EP0 descriptor chain pointers */
 	if (using_desc_dma(hs) && !hs_ep->index) {
@@ -2128,8 +2213,13 @@ static void dwc2_hsotg_complete_request(struct dwc2_hsotg *hsotg,
 	if (hs_req->req.status == -EINPROGRESS)
 		hs_req->req.status = result;
 
-	if (using_dma(hsotg))
+	if (using_dma(hsotg)) {
+		dwc2_r1_measure_event(hs_ep, hs_req,
+				       DWC2_R1_UNMAP_BEGIN, result);
 		dwc2_hsotg_unmap_dma(hsotg, hs_ep, hs_req);
+		dwc2_r1_measure_event(hs_ep, hs_req,
+				       DWC2_R1_UNMAP_DONE, result);
+	}
 
 	dwc2_hsotg_handle_unaligned_buf_complete(hsotg, hs_ep, hs_req);
 
diff --git a/drivers/usb/dwc2/trace-r1.h b/drivers/usb/dwc2/trace-r1.h
new file mode 100644
--- /dev/null
+++ b/drivers/usb/dwc2/trace-r1.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM dwc2_r1
+
+#if !defined(_TRACE_DWC2_R1_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_DWC2_R1_H
+
+#include <linux/tracepoint.h>
+
+TRACE_EVENT(dwc2_r1_lifetime,
+	TP_PROTO(u8 stage, u64 req_id, u64 map_id, u8 ep_index,
+		 u64 dma_addr, u32 length, u32 actual, int result,
+		 int status, bool dma_mapped),
+
+	TP_ARGS(stage, req_id, map_id, ep_index, dma_addr, length, actual,
+		result, status, dma_mapped),
+
+	TP_STRUCT__entry(
+		__field(u8, stage)
+		__field(u64, req_id)
+		__field(u64, map_id)
+		__field(u8, ep_index)
+		__field(u64, dma_addr)
+		__field(u32, length)
+		__field(u32, actual)
+		__field(int, result)
+		__field(int, status)
+		__field(bool, dma_mapped)
+	),
+
+	TP_fast_assign(
+		__entry->stage = stage;
+		__entry->req_id = req_id;
+		__entry->map_id = map_id;
+		__entry->ep_index = ep_index;
+		__entry->dma_addr = dma_addr;
+		__entry->length = length;
+		__entry->actual = actual;
+		__entry->result = result;
+		__entry->status = status;
+		__entry->dma_mapped = dma_mapped;
+	),
+
+	TP_printk("stage=%u req=%llu map=%llu ep=%u dma=0x%llx len=%u actual=%u result=%d status=%d dma_mapped=%u",
+		  __entry->stage,
+		  (unsigned long long)__entry->req_id,
+		  (unsigned long long)__entry->map_id,
+		  __entry->ep_index,
+		  (unsigned long long)__entry->dma_addr,
+		  __entry->length, __entry->actual, __entry->result,
+		  __entry->status, __entry->dma_mapped)
+);
+
+#endif /* _TRACE_DWC2_R1_H */
+
+#undef TRACE_INCLUDE_PATH
+#define TRACE_INCLUDE_PATH ../../drivers/usb/dwc2
+#undef TRACE_INCLUDE_FILE
+#define TRACE_INCLUDE_FILE trace-r1
+
+#include <trace/define_trace.h>
