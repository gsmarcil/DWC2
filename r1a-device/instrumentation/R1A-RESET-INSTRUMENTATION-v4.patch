 		}
@@ -1214,6 +1417,8 @@ static void dwc2_hsotg_start_req(struct dwc2_hsotg *hsotg,
 
 	dev_dbg(hsotg->dev, "%s: DxEPCTL=0x%08x\n", __func__, ctrl);
