diff --git a/drivers/usb/dwc2/gadget.c b/drivers/usb/dwc2/gadget.c
index c8b02c27d..b3ef2bb2c 100644
--- a/drivers/usb/dwc2/gadget.c
+++ b/drivers/usb/dwc2/gadget.c
@@ -23,6 +23,12 @@
 #include <linux/io.h>
 #include <linux/slab.h>
 
+#ifdef CONFIG_USB_DWC2_R1_MEASURE
+#include <linux/atomic.h>
+#define CREATE_TRACE_POINTS
+#include "trace-r1.h"
+#endif
+
 #include <linux/usb/ch9.h>
 #include <linux/usb/gadget.h>
 #include <linux/usb/phy.h>
@@ -105,6 +111,202 @@ static inline bool using_desc_dma(struct dwc2_hsotg *hsotg)
 	return hsotg->params.g_dma_desc;
 }
 
+enum dwc2_r1_lifetime_stage {
+	DWC2_R1_MAP = 1,
+	DWC2_R1_PROGRAMMED = 2,
+	DWC2_R1_XFERCOMPL_PATH = 3,
+	DWC2_R1_EPDIS_ASSERT = 4,
+	DWC2_R1_WAIT_RETURN = 5,
+	DWC2_R1_PRE_U = 6,
+	DWC2_R1_UNMAP_BEGIN = 7,
+	DWC2_R1_UNMAP_DONE = 8,
+	DWC2_R1_RESET_ENTRY = 9,
+};
+
+#ifdef CONFIG_USB_DWC2_R1_MEASURE
+static atomic64_t dwc2_r1_req_seq = ATOMIC64_INIT(0);
+static atomic64_t dwc2_r1_map_seq = ATOMIC64_INIT(0);
+static atomic64_t dwc2_r1_reset_seq = ATOMIC64_INIT(0);
+
+static void dwc2_r1_measure_reset(struct dwc2_hsotg_req *hs_req)
+{
+	hs_req->r1_req_id = 0;
+	hs_req->r1_map_id = 0;
+	hs_req->r1_program_id = 0;
+	hs_req->r1_reset_id = 0;
+	hs_req->r1_dma = 0;
+	hs_req->r1_length = 0;
+	hs_req->r1_linear = false;
+}
+
+static bool dwc2_r1_measure_eligible(struct dwc2_hsotg *hsotg,
+				     struct dwc2_hsotg_ep *hs_ep,
+				     struct dwc2_hsotg_req *hs_req)
+{
+	struct usb_request *req = &hs_req->req;
+
+	return using_dma(hsotg) && !using_desc_dma(hsotg) && hs_ep->index &&
+	       !hs_ep->dir_in && hs_ep->ep.desc &&
+	       usb_endpoint_xfer_bulk(hs_ep->ep.desc) && req->length &&
+	       !req->sg_was_mapped && !req->num_sgs && req->dma_mapped &&
+	       !hs_req->saved_req_buf;
+}
+
+static void dwc2_r1_emit(struct dwc2_hsotg *hsotg,
+			 struct dwc2_hsotg_ep *hs_ep,
+			 struct dwc2_hsotg_req *hs_req,
+			 u8 stage, int result, bool snapshot_regs,
+			 dma_addr_t program_dma, u8 flags)
+{
+	dma_addr_t event_dma = 0, event_program_dma = 0;
+	u32 event_length = 0, event_actual = 0;
+	int event_result = 0, event_status = 0;
+	bool event_dma_mapped = false;
+	u32 epctl = 0, epint = 0, epsiz = 0;
+	u64 epint_seq = 0;
+
+	if (!hs_req || !hs_req->r1_linear)
+		return;
+
+	/*
+	 * UNMAP_DONE is intentionally post-lifetime. Keep that event free of
+	 * retired-mapping/request-payload reads: only stable lineage metadata
+	 * and raw endpoint MMIO are emitted after U. Mapping/payload fields
+	 * are zero sentinels for this stage.
+	 */
+	if (stage != DWC2_R1_UNMAP_DONE) {
+		event_dma = hs_req->r1_dma;
+		event_program_dma = program_dma;
+		event_length = hs_req->r1_length;
+		event_actual = hs_req->req.actual;
+		event_result = result;
+		event_status = hs_req->req.status;
+		event_dma_mapped = hs_req->req.dma_mapped;
+	}
+
+	if (!hs_ep->dir_in) {
+		epint_seq = hs_ep->r1_epint_seq;
+		if (snapshot_regs) {
+			epctl = dwc2_readl(hsotg, DOEPCTL(hs_ep->index));
+			epint = dwc2_readl(hsotg, DOEPINT(hs_ep->index));
+			epsiz = dwc2_readl(hsotg, DOEPTSIZ(hs_ep->index));
+		}
+	}
+
+	trace_dwc2_r1_lifetime(stage, hs_req->r1_req_id,
+			       hs_req->r1_map_id, hs_req->r1_program_id,
+			       hs_req->r1_reset_id, hs_ep->index,
+			       event_dma, event_program_dma,
+			       event_length, event_actual,
+			       event_result, event_status,
+			       event_dma_mapped, epctl, epint, epsiz,
+			       epint_seq, flags);
+}
+
+static void dwc2_r1_measure_mapped(struct dwc2_hsotg *hsotg,
+				   struct dwc2_hsotg_ep *hs_ep,
+				   struct dwc2_hsotg_req *hs_req)
+{
+	if (!dwc2_r1_measure_eligible(hsotg, hs_ep, hs_req))
+		return;
+
+	hs_req->r1_req_id = atomic64_inc_return(&dwc2_r1_req_seq);
+	hs_req->r1_map_id = atomic64_inc_return(&dwc2_r1_map_seq);
+	hs_req->r1_program_id = 0;
+	hs_req->r1_reset_id = 0;
+	hs_req->r1_dma = hs_req->req.dma;
+	hs_req->r1_length = hs_req->req.length;
+	hs_req->r1_linear = true;
+	dwc2_r1_emit(hsotg, hs_ep, hs_req, DWC2_R1_MAP, 0, false, 0, 0);
+}
+
+static void dwc2_r1_measure_programmed(struct dwc2_hsotg *hsotg,
+				       struct dwc2_hsotg_ep *hs_ep,
+				       struct dwc2_hsotg_req *hs_req,
+				       bool dma_written)
+{
+	dma_addr_t program_dma = 0;
+
+	if (!hs_req || !hs_req->r1_linear || hs_ep->dir_in)
+		return;
+
+	hs_req->r1_program_id++;
+	if (dma_written)
+		program_dma = hs_req->req.dma;
+	dwc2_r1_emit(hsotg, hs_ep, hs_req, DWC2_R1_PROGRAMMED, 0,
+		     false, program_dma, dma_written ? 1 : 0);
+}
+
+static void dwc2_r1_measure_event(struct dwc2_hsotg *hsotg,
+				  struct dwc2_hsotg_ep *hs_ep,
+				  struct dwc2_hsotg_req *hs_req,
+				  u8 stage, int result, bool snapshot_regs)
+{
+	dwc2_r1_emit(hsotg, hs_ep, hs_req, stage, result,
+		     snapshot_regs, 0, 0);
+}
+
+static void dwc2_r1_measure_epint_enter(struct dwc2_hsotg_ep *hs_ep)
+{
+	if (hs_ep && !hs_ep->dir_in)
+		hs_ep->r1_epint_seq++;
+}
+
+static bool dwc2_r1_measure_reset_active(struct dwc2_hsotg_req *hs_req)
+{
+	return hs_req && hs_req->r1_linear && hs_req->r1_reset_id != 0;
+}
+
+static void dwc2_r1_measure_reset_entry(struct dwc2_hsotg *hsotg,
+					u32 gintsts)
+{
+	u64 reset_id = atomic64_inc_return(&dwc2_r1_reset_seq);
+	u8 flags = 0;
+	unsigned int idx;
+
+	if (gintsts & GINTSTS_USBRST)
+		flags |= BIT(0);
+	if (gintsts & GINTSTS_RESETDET)
+		flags |= BIT(1);
+
+	for (idx = 1; idx < hsotg->num_of_eps; idx++) {
+		struct dwc2_hsotg_ep *hs_ep = hsotg->eps_out[idx];
+		struct dwc2_hsotg_req *hs_req;
+
+		if (!hs_ep)
+			continue;
+		hs_req = hs_ep->req;
+		if (!hs_req || !hs_req->r1_linear)
+			continue;
+
+		hs_req->r1_reset_id = reset_id;
+		dwc2_r1_emit(hsotg, hs_ep, hs_req, DWC2_R1_RESET_ENTRY,
+			     0, true, 0, flags);
+	}
+}
+#else
+static inline void dwc2_r1_measure_reset(struct dwc2_hsotg_req *hs_req) { }
+static inline void dwc2_r1_measure_mapped(struct dwc2_hsotg *hsotg,
+					  struct dwc2_hsotg_ep *hs_ep,
+					  struct dwc2_hsotg_req *hs_req) { }
+static inline void dwc2_r1_measure_programmed(struct dwc2_hsotg *hsotg,
+					      struct dwc2_hsotg_ep *hs_ep,
+					      struct dwc2_hsotg_req *hs_req,
+					      bool dma_written) { }
+static inline void dwc2_r1_measure_event(struct dwc2_hsotg *hsotg,
+					 struct dwc2_hsotg_ep *hs_ep,
+					 struct dwc2_hsotg_req *hs_req,
+					 u8 stage, int result,
+					 bool snapshot_regs) { }
+static inline void dwc2_r1_measure_epint_enter(struct dwc2_hsotg_ep *hs_ep) { }
+static inline bool dwc2_r1_measure_reset_active(struct dwc2_hsotg_req *hs_req)
+{
+	return false;
+}
+static inline void dwc2_r1_measure_reset_entry(struct dwc2_hsotg *hsotg,
+					       u32 gintsts) { }
+#endif
+
 /**
  * dwc2_gadget_incr_frame_num - Increments the targeted frame number.
  * @hs_ep: The endpoint
@@ -1182,6 +1384,7 @@ static void dwc2_hsotg_start_req(struct dwc2_hsotg *hsotg,
 
 			dwc2_writel(hsotg, ureq->dma, dma_reg);
 
+
