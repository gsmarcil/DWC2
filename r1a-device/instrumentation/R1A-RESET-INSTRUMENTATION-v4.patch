diff --git a/drivers/usb/dwc2/Kconfig b/drivers/usb/dwc2/Kconfig
index d7af55a8e..53e017670 100644
--- a/drivers/usb/dwc2/Kconfig
+++ b/drivers/usb/dwc2/Kconfig
@@ -84,6 +84,18 @@ config USB_DWC2_TRACK_MISSED_SOFS
 	  WARNING: This feature is still experimental.
 	  If in doubt, say N.
 
+config USB_DWC2_R1_MEASURE
+	bool "Enable DWC2 R1 DMA lifetime tracepoints"
+	depends on TRACING
+	default n
+	help
+	  Enable measurement-only tracepoints for the DWC2 R1 DMA lifetime
+	  experiment. The first campaign admits only non-EP0 Bulk OUT requests
+	  using address/buffer DMA, a core-owned linear mapping, and no DWC2
+	  alignment bounce. It records mapping/programming/unmap ordering and
+	  stable request/map generations; it does not assert a post-unmap DMA
+	  issue or memory effect. Say N for normal kernels.
+
 config USB_DWC2_DEBUG_PERIODIC
 	bool "Enable Debugging Messages For Periodic Transfers"
 	depends on USB_DWC2_DEBUG || USB_DWC2_VERBOSE
