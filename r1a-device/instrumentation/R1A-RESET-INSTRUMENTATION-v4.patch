diff --git a/drivers/usb/dwc2/trace-r1.h b/drivers/usb/dwc2/trace-r1.h
new file mode 100644
index 000000000..c06f7f292
--- /dev/null
+++ b/drivers/usb/dwc2/trace-r1.h
@@ -0,0 +1,85 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM dwc2_r1
+
+#if !defined(_TRACE_DWC2_R1_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_DWC2_R1_H
+
+#include <linux/tracepoint.h>
+
+TRACE_EVENT(dwc2_r1_lifetime,
+	TP_PROTO(u8 stage, u64 req_id, u64 map_id, u64 program_id,
+		 u64 reset_id, u8 ep_index, u64 dma_addr, u64 program_dma,
+		 u32 length, u32 actual, int result, int status,
+		 bool dma_mapped, u32 epctl, u32 epint, u32 epsiz,
+		 u64 epint_seq, u8 flags),
+
+	TP_ARGS(stage, req_id, map_id, program_id, reset_id, ep_index,
+		dma_addr, program_dma, length, actual, result, status,
+		dma_mapped, epctl, epint, epsiz, epint_seq, flags),
+
+	TP_STRUCT__entry(
+		__field(u8, stage)
+		__field(u64, req_id)
+		__field(u64, map_id)
+		__field(u64, program_id)
+		__field(u64, reset_id)
+		__field(u8, ep_index)
+		__field(u64, dma_addr)
+		__field(u64, program_dma)
+		__field(u32, length)
+		__field(u32, actual)
+		__field(int, result)
+		__field(int, status)
+		__field(bool, dma_mapped)
+		__field(u32, epctl)
+		__field(u32, epint)
+		__field(u32, epsiz)
+		__field(u64, epint_seq)
+		__field(u8, flags)
+	),
+
+	TP_fast_assign(
+		__entry->stage = stage;
+		__entry->req_id = req_id;
+		__entry->map_id = map_id;
+		__entry->program_id = program_id;
+		__entry->reset_id = reset_id;
+		__entry->ep_index = ep_index;
+		__entry->dma_addr = dma_addr;
+		__entry->program_dma = program_dma;
+		__entry->length = length;
+		__entry->actual = actual;
+		__entry->result = result;
+		__entry->status = status;
+		__entry->dma_mapped = dma_mapped;
+		__entry->epctl = epctl;
+		__entry->epint = epint;
+		__entry->epsiz = epsiz;
+		__entry->epint_seq = epint_seq;
+		__entry->flags = flags;
+	),
+
+	TP_printk("stage=%u req=%llu map=%llu program=%llu reset=%llu ep=%u dma=0x%llx program_dma=0x%llx len=%u actual=%u result=%d status=%d dma_mapped=%u epctl=0x%08x epint=0x%08x epsiz=0x%08x epint_seq=%llu flags=0x%x",
+		  __entry->stage,
+		  (unsigned long long)__entry->req_id,
+		  (unsigned long long)__entry->map_id,
+		  (unsigned long long)__entry->program_id,
+		  (unsigned long long)__entry->reset_id,
+		  __entry->ep_index,
+		  (unsigned long long)__entry->dma_addr,
+		  (unsigned long long)__entry->program_dma,
+		  __entry->length, __entry->actual, __entry->result,
+		  __entry->status, __entry->dma_mapped, __entry->epctl,
+		  __entry->epint, __entry->epsiz,
+		  (unsigned long long)__entry->epint_seq, __entry->flags)
+);
+
+#endif /* _TRACE_DWC2_R1_H */
+
+#undef TRACE_INCLUDE_PATH
+#define TRACE_INCLUDE_PATH ../../drivers/usb/dwc2
+#undef TRACE_INCLUDE_FILE
+#define TRACE_INCLUDE_FILE trace-r1
+
+#include <trace/define_trace.h>
