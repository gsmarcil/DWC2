+/*
+ * Classify what usb_gadget_unmap_request() would actually do to this request,
+ * using the same tests udc/core.c uses, in the same order.  Returns the class
+ * and ORs the matching provenance bits into *f2.
+ */
+static u8 dwc2_r1_classify_mapping(struct dwc2_hsotg_req *hs_req, u16 *f2)
+{
+	struct usb_request *req;
+
+	if (!hs_req)
+		return DWC2_R1_MAP_NONE;
+
+	req = &hs_req->req;
+	if (req->dma_mapped)
+		*f2 |= DWC2_R1_F2_DMA_MAPPED;
+	if (req->sg_was_mapped)
+		*f2 |= DWC2_R1_F2_SG_WAS_MAPPED;
+	if (hs_req->saved_req_buf)
+		*f2 |= DWC2_R1_F2_BOUNCE_ACTIVE;
+
+	/*
+	 * num_sgs and num_mapped_sgs are unsigned int in struct usb_request
+	 * (include/linux/usb/gadget.h:109-110) but 16 bits in the record.  Flag
+	 * the truncation rather than let an analyzer read a wrapped count as a
+	 * real one.
+	 */
+	if (req->num_sgs > U16_MAX || req->num_mapped_sgs > U16_MAX)
+		*f2 |= DWC2_R1_F2_SG_COUNT_OVERFLOW;
+
+	/* udc/core.c:966 tests length first: a zero-length unmap does nothing */
+	if (!req->length)
+		return DWC2_R1_MAP_ZERO_LENGTH;
+
+	/*
+	 * sg_was_mapped means the core did not create this mapping, and
+	 * udc/core.c:917 still sets num_mapped_sgs = num_sgs, so that field on
+	 * its own is never evidence of ownership -- only after this test is it
+	 * usable.
+	 */
+	if (req->sg_was_mapped)
+		return DWC2_R1_MAP_NOT_CORE_OWNED;
+
+	/*
+	 * From here the branches follow udc/core.c:969-978 exactly:
+	 *
+	 *	if (req->num_mapped_sgs)	dma_unmap_sg
+	 *	else if (req->dma_mapped)	dma_unmap_single
+	 *
+	 * so the gate is num_mapped_sgs, not num_sgs.  An earlier version
+	 * branched on num_sgs; that usually agrees, but it is not what unmap
+	 * tests, and the claim of matching it was therefore untrue.
+	 */
+	if (req->num_mapped_sgs) {
+		if (!req->num_sgs)
+			return DWC2_R1_MAP_INCONSISTENT_SG;
+		*f2 |= DWC2_R1_F2_CORE_OWNED | DWC2_R1_F2_U_ELIG_SG;
+		return DWC2_R1_MAP_SG;
+	}
+
+	if (req->dma_mapped) {
+		*f2 |= DWC2_R1_F2_CORE_OWNED | DWC2_R1_F2_U_ELIG_LINEAR;
+		return DWC2_R1_MAP_LINEAR;
+	}
+
+	return DWC2_R1_MAP_UNKNOWN;
+}
