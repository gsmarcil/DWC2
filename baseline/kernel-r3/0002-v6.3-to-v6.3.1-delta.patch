+/*
+ * Denominator for the delayed-dequeue path.
+ *
+ * f_mass_storage reaches stop_xfr through usb_ep_dequeue(), not ep_disable(),
+ * so dwc2_r1_note_disable_candidate() never sees it and there was no way to
+ * say "0 timeouts out of N valid attempts" for that path at all.
+ *
+ * This uses only software state -- no extra MMIO before the wait, which is the
+ * property the whole observer is built around.  The endpoint type comes from
+ * hs_ep->ep.desc rather than a DOEPCTL read.
+ *
+ * ASYMMETRY, on purpose and recorded: the disable-path candidate confirms
+ * DXEPCTL_EPENA and DXEPCTL_EPTYPE_BULK from a register read the driver was
+ * making anyway.  Here there is no such read, so this counter is a slightly
+ * weaker denominator.  The two are kept in separate header fields so an
+ * analyzer can never add them together.
+ */
+static void dwc2_r1_note_dequeue_candidate(struct dwc2_hsotg *hsotg,
+					   struct dwc2_hsotg_ep *hs_ep,
+					   struct dwc2_hsotg_req *hs_req)
+{
+	struct dwc2_r1_state *r1 = hsotg->r1;
+	const struct usb_endpoint_descriptor *desc;
+
+	if (!r1 || r1->trigger == DWC2_R1_TRIG_NONE ||
+	    r1->setup_phase != 2 ||
+	    !dwc2_r1_trackable_out_ep(hs_ep) ||
+	    !using_dma(hsotg) || using_desc_dma(hsotg))
+		return;
+
+	desc = hs_ep->ep.desc;
+	if (!desc || !usb_endpoint_xfer_bulk(desc))
+		return;
+
+	if (!hs_req || hs_req != hs_ep->req ||
+	    !hs_req->trace_seq || !hs_req->trace_hw_programmed ||
+	    !hs_req->req.length || hs_req->req.status != -EINPROGRESS)
+		return;
 
-	*f2 |= DWC2_R1_F2_CORE_OWNED | DWC2_R1_F2_U_ELIG_LINEAR;
-	return DWC2_R1_MAP_LINEAR;
+	r1->candidate_delayed_dequeue_seen++;
 }
 
