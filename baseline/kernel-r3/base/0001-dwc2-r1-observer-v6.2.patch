+static const struct file_operations dwc2_r1_trace_fops = {
+	.owner = THIS_MODULE,
+	.open = dwc2_r1_trace_open,
+	.read = dwc2_r1_trace_read,
+	.llseek = default_llseek,
+	.release = dwc2_r1_trace_release,
+};
+
+static ssize_t dwc2_r1_reset_write(struct file *file,
+				   const char __user *buf, size_t len,
+				   loff_t *ppos)
+{
+	struct dwc2_hsotg *hsotg = file->private_data;
+	struct dwc2_r1_state *r1 = hsotg->r1;
+	unsigned long irqflags;
+	char cmd[7];
+
+	if (!r1)
+		return -ENODEV;
+	if (!((len == 5) || (len == 6)))
+		return -EINVAL;
+	if (copy_from_user(cmd, buf, len))
+		return -EFAULT;
+	if (len == 5) {
+		if (memcmp(cmd, "clear", 5))
+			return -EINVAL;
+	} else if (memcmp(cmd, "clear\n", 6)) {
+		return -EINVAL;
+	}
+
+	spin_lock_irqsave(&hsotg->lock, irqflags);
+	if (r1->trigger != DWC2_R1_TRIG_NONE ||
+	    r1->stop_caller != DWC2_R1_STOP_NONE) {
+		spin_unlock_irqrestore(&hsotg->lock, irqflags);
+		return -EBUSY;
+	}
+	r1->count = 0;
+	r1->lost = false;
+	r1->setup_cfg0_seen = 0;
+	r1->setup_cfgn_seen = 0;
+	r1->setup_intf_seen = 0;
+	r1->candidate_cfg0_seen = 0;
+	r1->candidate_cfgn_seen = 0;
+	r1->candidate_intf_seen = 0;
+	r1->reset_generation++;
+	spin_unlock_irqrestore(&hsotg->lock, irqflags);
+
+	return len;
+}
+
+static int dwc2_r1_reset_open(struct inode *inode, struct file *file)
+{
+	file->private_data = inode->i_private;
+	return 0;
+}
+
+static const struct file_operations dwc2_r1_reset_fops = {
+	.owner = THIS_MODULE,
+	.open = dwc2_r1_reset_open,
+	.write = dwc2_r1_reset_write,
+	.llseek = no_llseek,
+};
+
+void dwc2_r1_debugfs_init(struct dwc2_hsotg *hsotg)
+{
+	if (!hsotg->r1)
+		return;
+
+	debugfs_create_file("r1_trace", 0444, hsotg->debug_root, hsotg,
+			    &dwc2_r1_trace_fops);
+	debugfs_create_file("r1_reset", 0200, hsotg->debug_root, hsotg,
+			    &dwc2_r1_reset_fops);
+}
