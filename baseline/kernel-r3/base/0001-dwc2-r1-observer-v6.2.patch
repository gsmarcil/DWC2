+config DWC2_REQ_UNMAP_R1_OBSERVER
+	bool "DWC2 R1 stop-timeout observer (TEST ONLY)"
+	depends on DEBUG_FS
+	depends on USB_DWC2_PERIPHERAL || USB_DWC2_DUAL_ROLE
+	help
+	  Enable observer-only instrumentation for DWC2 host-driven
+	  endpoint-teardown experiments. The observer tracks standard
+	  SET_CONFIGURATION and SET_INTERFACE triggers, records only
